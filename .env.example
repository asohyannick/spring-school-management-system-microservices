


# ==============================================================
#  Spring Profiles
# ==============================================================
SPRING_PROFILES_ACTIVE=local


# ==============================================================
#  Infrastructure Ports
# ==============================================================
DISCOVERY_SERVER_PORT=8761
CONFIG_SERVER_PORT=8888
API_GATEWAY_PORT=8080


# ==============================================================
#  Microservice Ports
# ==============================================================
AUTH_SERVICE_PORT=8081
ADMISSION_SERVICE_PORT=8082
COURSE_SERVICE_PORT=8083
ASSIGNMENT_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085
QUIZ_SERVICE_PORT=8086
INVENTORY_SERVICE_PORT=8087
HUMAN_RESOURCE_SERVICE_PORT=8088
REVIEW_SERVICE_PORT=8089
STAFF_PROFILE_SERVICE_PORT=8090
STUDENT_PROFILE_SERVICE_PORT=8091


# ==============================================================
#  Eureka Discovery Server
# ==============================================================
EUREKA_USER=eureka
EUREKA_PASSWORD=secret
EUREKA_HOST=localhost
EUREKA_PORT=8761
# Local:  http://eureka:secret@localhost:8761/eureka/
# Docker: http://eureka:secret@discovery-server:8761/eureka/
EUREKA_DEFAULT_ZONE=http://${EUREKA_USER}:${EUREKA_PASSWORD}@${EUREKA_HOST}:${EUREKA_PORT}/eureka/


# ==============================================================
#  Config Server
# ==============================================================
CONFIG_SERVER_HOST=localhost
CONFIG_SERVER_URI=http://${CONFIG_SERVER_HOST}:${CONFIG_SERVER_PORT}
# Git repository where all service application.yml files are stored
CONFIG_SERVER_GIT_URI=https://github.com/your-org/sms-config-repo
CONFIG_SERVER_GIT_BRANCH=main


# ==============================================================
#  PostgreSQL
#  Used by: auth-service, admission-service,
#           payment-service, human-resource-service
# ==============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sms_db
POSTGRES_USER=sms
POSTGRES_PASSWORD=changeme_postgres

# Per-service databases (recommended — isolate each service's schema)
AUTH_POSTGRES_DB=sms_auth_db
ADMISSION_POSTGRES_DB=sms_admission_db
PAYMENT_POSTGRES_DB=sms_payment_db
HR_POSTGRES_DB=sms_hr_db

# JDBC URLs — Local
AUTH_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${AUTH_POSTGRES_DB}
ADMISSION_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${ADMISSION_POSTGRES_DB}
PAYMENT_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${PAYMENT_POSTGRES_DB}
HR_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${HR_POSTGRES_DB}

POSTGRES_USERNAME=${POSTGRES_USER}
POSTGRES_PASSWORD_VALUE=${POSTGRES_PASSWORD}


# ==============================================================
#  MySQL
#  Used by: course-service, assignment-service, quiz-service,
#           inventory-service, staffProfile-service,
#           studentProfile-service
# ==============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=changeme_mysql_root
MYSQL_USER=sms
MYSQL_PASSWORD=changeme_mysql

# Per-service databases
COURSE_MYSQL_DB=sms_course_db
ASSIGNMENT_MYSQL_DB=sms_assignment_db
QUIZ_MYSQL_DB=sms_quiz_db
INVENTORY_MYSQL_DB=sms_inventory_db
STAFF_PROFILE_MYSQL_DB=sms_staff_profile_db
STUDENT_PROFILE_MYSQL_DB=sms_student_profile_db

# JDBC URLs — Local
COURSE_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${COURSE_MYSQL_DB}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ASSIGNMENT_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${ASSIGNMENT_MYSQL_DB}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
QUIZ_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${QUIZ_MYSQL_DB}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
INVENTORY_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${INVENTORY_MYSQL_DB}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
STAFF_PROFILE_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${STAFF_PROFILE_MYSQL_DB}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
STUDENT_PROFILE_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${STUDENT_PROFILE_MYSQL_DB}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

MYSQL_USERNAME=${MYSQL_USER}
MYSQL_PASSWORD_VALUE=${MYSQL_PASSWORD}


# ==============================================================
#  MongoDB
#  Used by: review-service
# ==============================================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=sms
MONGO_PASSWORD=changeme_mongo
MONGO_DB=sms_reviews_db
MONGO_AUTH_SOURCE=admin

# URI — Local
MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}?authSource=${MONGO_AUTH_SOURCE}


# ==============================================================
#  Redis (API Gateway rate limiting)
# ==============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis


# ==============================================================
#  Kafka
# ==============================================================
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_HOST}:${KAFKA_PORT}
ZOOKEEPER_HOST=localhost
ZOOKEEPER_PORT=2181


# ==============================================================
#  JWT (auth-service + api-gateway)
# ==============================================================
JWT_SECRET=your-super-secret-256-bit-key-replace-this-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000


# ==============================================================
#  Firebase (auth-service)
# ==============================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=classpath:firebase-service-account.json


# ==============================================================
#  Mail (auth-service)
# ==============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_PROTOCOL=smtp
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true


# ==============================================================
#  Stripe (payment-service)
# ==============================================================
STRIPE_API_KEY=sk_test_replace_with_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret


# ==============================================================
#  PayPal (payment-service)
# ==============================================================
PAYPAL_CLIENT_ID=replace_with_your_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_your_paypal_client_secret
PAYPAL_MODE=sandbox


# ==============================================================
#  Actuator
# ==============================================================
MANAGEMENT_ENDPOINTS_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always